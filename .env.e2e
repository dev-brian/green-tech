# Build de pruebas e2e (`pnpm test:e2e`): la PWA habla con los emuladores
# locales de Auth y Firestore, nunca con el proyecto real. No son secretos.
VITE_FIREBASE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=127.0.0.1
VITE_FIREBASE_PROJECT_ID=demo-green-tech-e2e
VITE_FIREBASE_STORAGE_BUCKET=demo-green-tech-e2e.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:e2e
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=
