rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper: ¿el usuario autenticado es miembro del invernadero? ─────────
    function isMember(greenhouseId) {
      return request.auth != null
          && exists(/databases/$(database)/documents/greenhouses/$(greenhouseId))
          && request.auth.uid in get(/databases/$(database)/documents/greenhouses/$(greenhouseId)).data.memberIds;
    }

    // ─── Helper: ¿el usuario autenticado es admin del invernadero? ───────────
    function isAdmin(greenhouseId) {
      return isMember(greenhouseId)
          && exists(/databases/$(database)/documents/greenhouses/$(greenhouseId)/members/$(request.auth.uid))
          && get(/databases/$(database)/documents/greenhouses/$(greenhouseId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    // ─── Invernaderos ────────────────────────────────────────────────────────
    match /greenhouses/{greenhouseId} {

      // Cualquier usuario autenticado puede leer para buscar por inviteCode al unirse.
      allow read: if request.auth != null;

      // Solo usuarios autenticados pueden crear un nuevo invernadero.
      // El creador debe incluirse en memberIds.
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.memberIds;

      // Actualización permitida a miembros (unirse via inviteCode, regenerar código).
      allow update: if request.auth != null;

      // Solo el admin del invernadero puede eliminarlo.
      allow delete: if isAdmin(greenhouseId);

      // ─── Subcolección de Miembros ─────────────────────────────────────────
      match /members/{memberId} {
        // Miembros del invernadero pueden leer la lista de miembros.
        allow read: if isMember(greenhouseId);

        // Escritura permitida a usuarios autenticados (para join/leave/remove).
        allow write: if request.auth != null;
      }

      // ─── Subcolección de Plantas ──────────────────────────────────────────
      match /plants/{plantId} {
        allow read:  if isMember(greenhouseId);
        allow write: if isMember(greenhouseId);
      }
    }

    // ─── Telemetría de Sensores ──────────────────────────────────────────────
    // Solo miembros del invernadero al que pertenece la lectura pueden acceder.
    match /telemetry_data/{docId} {
      allow read: if request.auth != null
                  && isMember(resource.data.greenhouseId);

      // Creación permitida a miembros. Append-only: no se permite update ni delete.
      allow create: if request.auth != null
                    && isMember(request.resource.data.greenhouseId);

      allow update, delete: if false;
    }

    // ─── Alertas ─────────────────────────────────────────────────────────────
    match /alerts/{alertId} {
      // Solo miembros del invernadero pueden leer sus alertas.
      allow read: if request.auth != null
                  && isMember(resource.data.greenhouseId);

      // Creación: miembros (cliente detecta umbral fuera de rango).
      allow create: if request.auth != null
                    && isMember(request.resource.data.greenhouseId);

      // Actualización: miembros pueden marcar como "atendida".
      // No se permite cambiar greenhouseId ni datos originales de la alerta.
      allow update: if request.auth != null
                    && isMember(resource.data.greenhouseId)
                    && request.resource.data.greenhouseId == resource.data.greenhouseId;

      // No se eliminan alertas (inmutabilidad para auditoría).
      allow delete: if false;
    }

  }
}
