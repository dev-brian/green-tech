rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model (GREEN TECH v0.2 Contract + Legacy Support)
    // ===============================================================
    //
    // Collection: /greenhouses/{greenhouseId}
    // Fields:
    //   - name: string (required, 1..200 chars)
    //   - inviteCode: string (required, 1..32 chars)
    //   - inviteCodeCreatedAt: string | timestamp (optional)
    //   - memberIds: list<string> (required, UIDs of members)
    //   - thresholds: map (optional, legacy: solo aplica a jitomate)
    //   - thresholdsByCrop: map {jitomate?, lechuga?} (optional, edited only by admin)
    //   - createdAt: string | timestamp (optional)
    //
    // Subcollection: /greenhouses/{greenhouseId}/members/{memberId}
    // Fields:
    //   - role: 'admin' | 'operador' (required)
    //   - email: string (optional)
    //   - name: string (optional)
    //   - joinedAt: string | timestamp (optional)
    //   - inviteCode: string (required when self-joining as 'operador')
    //
    // Subcollections: /greenhouses/{greenhouseId}/plants/{plantId},
    //                 /greenhouses/{greenhouseId}/actuators/{actuatorId}
    //   - Read: any member of the greenhouse
    //   - Write: only admin of the greenhouse
    //
    // Subcollection: /greenhouses/{greenhouseId}/zones/{zoneId} (HU-04, T4.1 #64)
    //   - zoneId: same id the sensor sends (e.g. 'zona-1'), [a-z0-9-], 1..40 chars
    //   - name: string (required, 1..60 chars)
    //   - crop: 'jitomate' | 'lechuga' (required)
    //   - createdAt, updatedAt: timestamp (optional)
    //   - Read: any member. Create / Update / Delete: only admin
    //
    // Subcollections: /greenhouses/{greenhouseId}/readings/{readingId},
    //                 /greenhouses/{greenhouseId}/readingsHourly/{hourId},
    //                 /greenhouses/{greenhouseId}/state/{docId}
    //   - Read: any member of the greenhouse
    //   - Write: backend / Admin SDK only (false for clients)
    //
    // Collection: /greenhouses/{greenhouseId}/alerts/{alertId} & /alerts/{alertId}
    //   - Read: any member of the greenhouse
    //   - Create / Delete: backend / Admin SDK only (false for clients)
    //   - Update: member may only acknowledge ('status' == 'attended', 'attendedBy' == request.auth.uid)
    //
    // Collection: /telemetry_data/{docId} (Legacy root telemetry)
    //   - Read: any member of resource.data.greenhouseId
    //   - Write: backend / Admin SDK only (false for clients)
    //
    // Collection: /greenhouse_invites/{inviteCode}
    //   - Get: any authenticated user (to resolve inviteCode -> greenhouseId)
    //   - List: denied (prevents enumerating invite codes)
    //   - Create: admin of the target greenhouse; doc id must equal its current inviteCode
    //   - Update: admin of the greenhouse the code already points to (greenhouseId immutable)
    //   - Delete: admin of the greenhouse the code points to
    //
    // Collection: /users/{uid}/fcmTokens/{tokenId}
    //   - Read / Write: owner only (request.auth.uid == uid)
    // ===============================================================

    // ─── Helper: ¿el usuario está autenticado? ───────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // ─── Helper: ¿el usuario autenticado es miembro del invernadero? ─────────
    function isMember(greenhouseId) {
      return isSignedIn()
          && greenhouseId is string
          && exists(/databases/$(database)/documents/greenhouses/$(greenhouseId))
          && request.auth.uid in get(/databases/$(database)/documents/greenhouses/$(greenhouseId)).data.memberIds;
    }

    // ─── Helper: ¿el usuario autenticado es admin del invernadero? ───────────
    function isAdmin(greenhouseId) {
      return isMember(greenhouseId)
          && exists(/databases/$(database)/documents/greenhouses/$(greenhouseId)/members/$(request.auth.uid))
          && get(/databases/$(database)/documents/greenhouses/$(greenhouseId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    // ─── Helper: validación de creación de invernadero ───────────────────────
    function isValidGreenhouseCreate() {
      return isSignedIn()
          && request.resource.data.memberIds is list
          && request.resource.data.memberIds.size() == 1
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 200
          && request.resource.data.inviteCode is string
          && request.resource.data.inviteCode.size() > 0
          && request.resource.data.inviteCode.size() <= 32;
    }

    // ─── Helper: unión de operador mediante código de invitación válido ──────
    // Quien se une solo puede agregar su propio UID a memberIds, y en la MISMA
    // escritura (batch) debe crear members/{uid} con rol 'operador' y el
    // inviteCode vigente. Sin ese documento la unión se rechaza: conocer el id
    // del invernadero ya no basta (auditoría C1).
    function isJoiningWithValidInvite(greenhouseId) {
      let memberPath = /databases/$(database)/documents/greenhouses/$(greenhouseId)/members/$(request.auth.uid);
      return isSignedIn()
          && !(request.auth.uid in resource.data.memberIds)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
          && request.resource.data.memberIds is list
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.auth.uid in request.resource.data.memberIds
          && resource.data.inviteCode is string
          && resource.data.inviteCode.size() > 0
          && !exists(memberPath)
          && existsAfter(memberPath)
          && getAfter(memberPath).data.role == 'operador'
          && getAfter(memberPath).data.get('inviteCode', '') == resource.data.inviteCode;
    }

    // ─── Helper: miembro abandonando el invernadero ──────────────────────────
    function isLeavingGreenhouse() {
      return isSignedIn()
          && request.auth.uid in resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
          && request.resource.data.memberIds is list
          && resource.data.memberIds.hasAll(request.resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
          && !(request.auth.uid in request.resource.data.memberIds);
    }

    // ─── Helper: creador registrándose como admin inicial ────────────────────
    // Solo en el mismo batch que crea el invernadero. Ya no existe la rama que
    // permitía crear un admin sobre un invernadero existente con un solo
    // miembro: un operador único podía borrar su documento y recrearlo como admin.
    function isCreatorBecomingAdmin(greenhouseId, memberId) {
      let ghPath = /databases/$(database)/documents/greenhouses/$(greenhouseId);
      return isSignedIn()
          && memberId == request.auth.uid
          && request.resource.data.role == 'admin'
          && !exists(ghPath)
          && existsAfter(ghPath)
          && getAfter(ghPath).data.memberIds is list
          && getAfter(ghPath).data.memberIds.size() == 1
          && request.auth.uid in getAfter(ghPath).data.memberIds;
    }

    // ─── Helper: usuario uniéndose como operador con inviteCode válido ───────
    // El documento de miembro solo se crea junto con la entrada en memberIds.
    function isSelfJoiningAsOperator(greenhouseId, memberId) {
      let ghPath = /databases/$(database)/documents/greenhouses/$(greenhouseId);
      return isSignedIn()
          && memberId == request.auth.uid
          && request.resource.data.role == 'operador'
          && exists(ghPath)
          && get(ghPath).data.inviteCode is string
          && get(ghPath).data.inviteCode.size() > 0
          && request.resource.data.get('inviteCode', '') == get(ghPath).data.inviteCode
          && request.auth.uid in getAfter(ghPath).data.memberIds;
    }

    // ─── Helper: un rango de umbral válido (redMin ≤ yellowMin ≤ yellowMax ≤ redMax)
    function isValidRange(r) {
      return r is map
          && r.keys().hasAll(['redMin', 'yellowMin', 'yellowMax', 'redMax'])
          && r.keys().hasOnly(['redMin', 'yellowMin', 'yellowMax', 'redMax'])
          && r.redMin is number
          && r.yellowMin is number
          && r.yellowMax is number
          && r.redMax is number
          && r.redMin <= r.yellowMin
          && r.yellowMin <= r.yellowMax
          && r.yellowMax <= r.redMax;
    }

    // ─── Helper: mapa de umbrales del invernadero (7 variables, todas opcionales)
    function isValidThresholds(t) {
      return t is map
          && t.keys().hasOnly(['airTemp', 'humidity', 'light', 'ph', 'ec', 'solutionTemp', 'tankLevel'])
          && (!('airTemp' in t)      || isValidRange(t.airTemp))
          && (!('humidity' in t)     || isValidRange(t.humidity))
          && (!('light' in t)        || isValidRange(t.light))
          && (!('ph' in t)           || isValidRange(t.ph))
          && (!('ec' in t)           || isValidRange(t.ec))
          && (!('solutionTemp' in t) || isValidRange(t.solutionTemp))
          && (!('tankLevel' in t)    || isValidRange(t.tankLevel));
    }

    // ─── Helper: umbrales por cultivo (thresholdsByCrop.{jitomate|lechuga})
    // Solo se valida el cultivo que cambió: validar los dos perfiles completos
    // en cada escritura rebasa el límite de 1000 expresiones de las reglas.
    function isValidThresholdsByCropUpdate() {
      let next = request.resource.data.thresholdsByCrop;
      let changedCrops = next.diff(resource.data.get('thresholdsByCrop', {})).affectedKeys();
      return next is map
          && next.keys().hasOnly(['jitomate', 'lechuga'])
          && (!('jitomate' in changedCrops) || isValidThresholds(next.jitomate))
          && (!('lechuga' in changedCrops)  || isValidThresholds(next.lechuga));
    }

    // ─── Helper: edición del invernadero por su admin ────────────────────────
    // Solo claves conocidas; memberIds solo puede perder miembros (expulsar o
    // salir), nunca ganar UIDs sin su documento de miembro.
    function isValidAdminGreenhouseUpdate(greenhouseId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isAdmin(greenhouseId)
          && changed.hasOnly(['name', 'inviteCode', 'inviteCodeCreatedAt', 'memberIds', 'thresholds', 'thresholdsByCrop'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 200
          && request.resource.data.inviteCode is string
          && request.resource.data.inviteCode.size() > 0
          && request.resource.data.inviteCode.size() <= 32
          && request.resource.data.memberIds is list
          && resource.data.memberIds.hasAll(request.resource.data.memberIds)
          && (!('thresholds' in changed) || isValidThresholds(request.resource.data.thresholds))
          && (!('thresholdsByCrop' in changed) || isValidThresholdsByCropUpdate());
    }

    // ─── Helper: documento de zona válido (T4.1 #64) ─────────────────────────
    function isValidZone(zoneId) {
      return zoneId.matches('^[a-z0-9-]{1,40}$')
          && request.resource.data.keys().hasOnly(['name', 'crop', 'createdAt', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.crop in ['jitomate', 'lechuga'];
    }

    // ─── Helper: acuse de recibo ("attended") de una alerta ──────────────────
    function isValidAlertAcknowledge() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'attendedBy', 'attendedAt'])
          && request.resource.data.status == 'attended'
          && request.resource.data.attendedBy == request.auth.uid;
    }

    // ─── Índice de códigos de invitación (/greenhouse_invites/{inviteCode}) ──
    match /greenhouse_invites/{inviteCode} {
      allow get: if isSignedIn();
      allow list: if false;

      // Crear: admin del invernadero destino (o su creador en el mismo batch),
      // y el código debe ser el inviteCode vigente de ese invernadero.
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasOnly(['greenhouseId', 'createdAt'])
                    && request.resource.data.greenhouseId is string
                    && (
                      isAdmin(request.resource.data.greenhouseId)
                      || (
                        !exists(/databases/$(database)/documents/greenhouses/$(request.resource.data.greenhouseId))
                        && existsAfter(/databases/$(database)/documents/greenhouses/$(request.resource.data.greenhouseId))
                        && request.auth.uid in getAfter(/databases/$(database)/documents/greenhouses/$(request.resource.data.greenhouseId)).data.memberIds
                      )
                    )
                    && getAfter(/databases/$(database)/documents/greenhouses/$(request.resource.data.greenhouseId)).data.inviteCode == inviteCode;

      // Actualizar: solo el admin del invernadero al que YA apunta el código, y
      // sin cambiar de invernadero (un admin ajeno no puede secuestrarlo).
      allow update: if isSignedIn()
                    && isAdmin(resource.data.greenhouseId)
                    && request.resource.data.keys().hasOnly(['greenhouseId', 'createdAt'])
                    && request.resource.data.greenhouseId == resource.data.greenhouseId;

      allow delete: if isSignedIn() && isAdmin(resource.data.greenhouseId);
    }

    // ─── Invernaderos (/greenhouses/{greenhouseId}) ──────────────────────────
    match /greenhouses/{greenhouseId} {

      // Solo miembros del invernadero pueden leerlo.
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;

      // Solo usuarios autenticados pueden crear un invernadero incluyéndose como único miembro inicial.
      allow create: if isValidGreenhouseCreate();

      // Actualización permitida a:
      // 1. Admin del invernadero (umbrales válidos, nombre, regeneración de inviteCode, expulsar miembros)
      // 2. Usuario que se une con código de invitación válido
      // 3. Miembro que abandona el invernadero
      allow update: if isValidAdminGreenhouseUpdate(greenhouseId)
                    || isJoiningWithValidInvite(greenhouseId)
                    || isLeavingGreenhouse();

      // Solo el admin del invernadero puede eliminarlo.
      allow delete: if isAdmin(greenhouseId);

      // ─── Subcolección de Miembros ─────────────────────────────────────────
      match /members/{memberId} {
        allow read: if isMember(greenhouseId);

        allow create: if isAdmin(greenhouseId)
                      || isCreatorBecomingAdmin(greenhouseId, memberId)
                      || isSelfJoiningAsOperator(greenhouseId, memberId);

        // Solo el admin puede cambiar roles o actualizar documentos de miembros.
        allow update: if isAdmin(greenhouseId)
                      && request.resource.data.role in ['admin', 'operador'];

        // El admin puede expulsar miembros, o el propio miembro puede salir.
        // Salir exige quitarse de memberIds en el mismo batch: así nadie puede
        // borrar su documento y recrearlo con otro rol.
        allow delete: if isAdmin(greenhouseId)
                      || (
                        isMember(greenhouseId)
                        && memberId == request.auth.uid
                        && !(request.auth.uid in getAfter(/databases/$(database)/documents/greenhouses/$(greenhouseId)).data.memberIds)
                      );
      }

      // ─── Subcolecciones de Configuración (Plantas, Zonas, Actuadores) ─────
      match /plants/{plantId} {
        allow read:  if isMember(greenhouseId);
        allow write: if isAdmin(greenhouseId);
      }

      match /zones/{zoneId} {
        allow read:           if isMember(greenhouseId);
        allow create, update: if isAdmin(greenhouseId) && isValidZone(zoneId);
        allow delete:         if isAdmin(greenhouseId);
      }

      match /actuators/{actuatorId} {
        allow read:  if isMember(greenhouseId);
        allow write: if isAdmin(greenhouseId);
      }

      // ─── Subcolecciones de Telemetría y Estado (v0.2 Data Contract) ───────
      match /readings/{readingId} {
        allow read:  if isMember(greenhouseId);
        allow write: if false;
      }

      match /readingsHourly/{hourId} {
        allow read:  if isMember(greenhouseId);
        allow write: if false;
      }

      match /state/{docId} {
        allow read:  if isMember(greenhouseId);
        allow write: if false;
      }

      // ─── Subcolección de Alertas (v0.2 Data Contract) ─────────────────────
      match /alerts/{alertId} {
        allow read:           if isMember(greenhouseId);
        allow create, delete: if false;
        allow update:         if isMember(greenhouseId) && isValidAlertAcknowledge();
      }
    }

    // ─── Tokens FCM por Usuario ──────────────────────────────────────────────
    match /users/{uid}/fcmTokens/{tokenId} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

  }
}
